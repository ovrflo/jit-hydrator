{
    "name": "ovrflo/jit-hydrator",
    "description": "A drop-in replacement for Doctrine ORM's default object hydrator capable of generating optimized hydration code for each query.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Catalin Dan",
            "email": "dancatalin18@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "doctrine/orm": "^2.4 || ^3.0"
    },
    "require-dev": {
        "doctrine/dbal": "^2.13 || ^3.0 || ^4.0",
        "phpunit/phpunit": "^9.6 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "Ovrflo\\JitHydrator\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ovrflo\\JitHydrator\\Tests\\": "tests/"
        }
    }
}
